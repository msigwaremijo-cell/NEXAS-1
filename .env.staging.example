# ---------------------------------------------------------------------------
# Nexas — staging environment template
#
# Copy to shared/.env on the server (see docs/deployment.md) and fill in the
# blanks. It is committed because it holds no secrets: every value here is a
# placeholder or a deliberate non-secret default. The .env it is copied into
# is never committed.
#
# The difference from .env.example is the part that matters: this file is what
# a server reads, so it turns debugging off, puts the cache, the session and
# the queue on Redis and the mailer on something other than the log.
# ---------------------------------------------------------------------------

APP_NAME=Nexas

# "staging" rather than "production" so the application can be told the two
# apart, and not "local" — a staging host is reachable from the internet.
APP_ENV=staging

# Generate on the server with:  php artisan key:generate
# Never copy the local key up. A staging database restored from production
# plus a staging APP_KEY would make every recorded password hash valid there.
APP_KEY=

# Off. A staging host sits on a public URL, and a stack trace prints the
# database password and the absolute paths of the machine.
APP_DEBUG=false

# The hostname in the Nginx server_name and the certificate. No trailing slash.
APP_URL=https://staging.example.co.tz

# Note: this line is absent from .env.example, where config/app.php falls back
# to UTC. Leaving it out here would move the whole nightly schedule — the
# backup at 03:15 would run at 06:15 Dar es Salaam time — and would write
# every log line in a different zone from the one the accountants read.
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack

# "daily" rather than "single": one file per day, so a runaway log cannot fill
# the disk in a single afternoon and an old day can be deleted on its own.
# Staging logs at debug on purpose — it is where a problem should be visible.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4. Give the application its own user; do not connect as root. The
# user needs SELECT, INSERT, UPDATE, DELETE, EXECUTE, SHOW VIEW and the right
# to create triggers, because the audit chain and the stock rules are triggers.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexas
DB_USERNAME=nexas
DB_PASSWORD=

# Sessions, cache and queue all on Redis, which is the stack the production
# host is sized for. SESSION_SECURE_COOKIE is the one that matters here: the
# application is served over HTTPS, and without it the session cookie travels
# in clear on the first plain-http request a browser makes.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The queue driver, and the connection holding the jobs. Each worker renders
# report exports and raises the nightly alerts, so it has to be a real queue
# and not `sync`, or the work happens in the request and the user waits.
QUEUE_CONNECTION=redis

# The queue name the workers read. Supervisor passes no --queue, so this is
# the single place it is set. See deploy/supervisor/nexas.conf.
REDIS_QUEUE=default

# Must stay above the worker's --timeout (240s in deploy/supervisor/nexas.conf).
# Below it, Redis would hand the same job to a second worker while the first
# was still running and a large export would be written twice. 300s leaves the
# worker room to die first and Redis to retry afterwards.
REDIS_QUEUE_RETRY_AFTER=300

CACHE_STORE=redis

# Prefixes every cache key, so this staging box can share a Redis instance
# without colliding with anything else on it.
CACHE_PREFIX=nexas_staging

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Database 0 for the queue and the session, database 1 for the cache. Separate
# numbers so `redis-cli FLUSHDB 1` clears the cache without touching a queued
# job, and so a memory report can tell the two apart.
REDIS_DB=0
REDIS_CACHE_DB=1

# Staging mail. "log" writes the messages to the log and sends nothing, which
# is the safe default for a box that may hold a copy of real customer data.
# Switch to smtp with a catch-all address once it is certain that is wanted.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Backups ---------------------------------------------------------------

# Required, not optional. A backup holds every journal, every party and every
# filed document, and this key is the only thing between that file and anyone
# who reads the disk. Generate it once with
#   php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# and keep a second copy somewhere other than this server — see
# docs/backups.md. A run without it refuses to write a backup at all.
#
# It is a key of its own: rotating APP_KEY must not make last month's backups
# unreadable, and losing this one makes every backup already taken unreadable.
NEXAS_BACKUP_KEY=

# The MySQL client binaries. Bare names mean "on PATH", which is where apt
# puts them; the full path is only for a machine that keeps them elsewhere.
NEXAS_MYSQLDUMP_BINARY=mysqldump
NEXAS_MYSQL_BINARY=mysql

# How long a nightly file is kept, and the number of newest files never pruned
# however old they are. The floor is what stops a run of failures leaving the
# company with nothing at all.
NEXAS_BACKUP_RETENTION_DAYS=30
NEXAS_BACKUP_KEEP=7

# The shape of the throwaway database a restore drill loads into. The restore
# refuses any other name and refuses the database the application is connected
# to, so a drill can never write over the books it is checking.
# The MySQL user needs:  GRANT ALL PRIVILEGES ON `nexas_restore\_%`.* TO 'nexas'@'localhost';
NEXAS_BACKUP_SCRATCH_PREFIX=nexas_restore_

# --- Report exports and attachments ---------------------------------------

# How long a finished export stays downloadable, and how long the signed URL
# on it stays valid — deliberately shorter, because the file outliving its own
# link is the point of signing it.
NEXAS_EXPORT_DISK=exports
NEXAS_EXPORT_RETENTION_HOURS=24
NEXAS_EXPORT_LINK_TTL_MINUTES=60

# The ceiling a single upload may reach. Nginx allows 16m and PHP allows 16M
# (deploy/nginx/nexas.conf, deploy/php/99-nexas.ini), both above this, so a
# file that is too large is refused by the application with a message the user
# can read rather than with the web server's own 413.
NEXAS_ATTACHMENT_DISK=attachments
NEXAS_ATTACHMENT_MAX_KILOBYTES=10240
NEXAS_ATTACHMENT_LINK_TTL_MINUTES=30

# --- Company policy and authentication -------------------------------------
#
# Every value below has a working default in config/nexas.php. They are listed
# commented out so a deployment can see what it may tighten without reading
# the config; uncommenting one overrides the default.
#
# NEXAS_DEFAULT_CURRENCY=TZS
# NEXAS_DEFAULT_COUNTRY=TZ
# NEXAS_INVENTORY_COSTING=fifo
# NEXAS_ALLOW_NEGATIVE_STOCK=false
#
# NEXAS_LOGIN_MAX_ATTEMPTS=5
# NEXAS_LOGIN_DECAY_SECONDS=60
# NEXAS_TOKEN_LIFETIME_MINUTES=10080
# NEXAS_PASSWORD_MIN_LENGTH=12
# NEXAS_TWO_FACTOR_CHALLENGE_TTL_MINUTES=5
# NEXAS_TWO_FACTOR_MAX_ATTEMPTS=10
